# Application
PORT=3000
NODE_ENV=production
FRONTEND_URL=http://localhost:5173

# JWT
JWT_SECRET=your-secret-key-change-in-production-12345

# Email Configuration (Optional but recommended for production)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@farmingtechshop.com

# Admin Credentials (set these in production)
ADMIN_EMAIL=admin@farmingtechshop.com
ADMIN_PASSWORD=admin123

# Payment Integration (Optional)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Database
DATABASE_URL=farming_tech.db
